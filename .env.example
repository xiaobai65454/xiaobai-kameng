# ====================================
# 号卡平台环境变量配置
# ====================================
# 复制此文件为 .env 并填入真实值

# --- 应用配置 ---
COZE_PROJECT_ENV=PROD
PORT=3000
HOSTNAME=0.0.0.0

# --- Supabase 数据库配置 ---
# 在 https://supabase.com 创建项目后获取
COZE_SUPABASE_URL=https://your-project.supabase.co
COZE_SUPABASE_ANON_KEY=your-anon-key-here
COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- 对象存储配置（文件上传功能，实名认证材料上传必需） ---
# C 端用户下单需上传身份证正反面/半身照/一证通查截图，依赖此配置
# 未配置时上传接口 /api/upload/public 将无法工作
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_ACCESS_KEY=
COZE_BUCKET_SECRET_KEY=
COZE_BUCKET_NAME=
